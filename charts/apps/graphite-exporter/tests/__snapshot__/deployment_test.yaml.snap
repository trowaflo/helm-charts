should match Deployment with correct args:
  1: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app.kubernetes.io/component: main
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: name-override-test
        helm.sh/chart: graphite-exporter-2.1.0
      name: RELEASE-NAME-name-override-test-main
      namespace: namespace-override-test
    spec:
      replicas: 1
      revisionHistoryLimit: 3
      selector:
        matchLabels:
          app.kubernetes.io/component: main
          app.kubernetes.io/instance: RELEASE-NAME
          app.kubernetes.io/name: name-override-test
      strategy:
        type: Recreate
      template:
        metadata:
          labels:
            app.kubernetes.io/component: main
            app.kubernetes.io/instance: RELEASE-NAME
            app.kubernetes.io/name: name-override-test
        spec:
          automountServiceAccountToken: false
          containers:
            - args:
                - --graphite.listen-address=:9109
              image: prom/graphite-exporter:v0.17.0@sha256:c1a266f63a84fd11048ab6ad1552a4c497b14522d02823925247698e41eeac2b
              imagePullPolicy: IfNotPresent
              name: main
              ports:
                - containerPort: 9109
                  name: graphite-tcp
                  protocol: TCP
                - containerPort: 9109
                  name: graphite-udp
                  protocol: UDP
                - containerPort: 9108
                  name: main
                  protocol: TCP
              resources:
                limits:
                  cpu: 2
                  memory: 2Gi
                requests:
                  cpu: 1m
                  memory: 32Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
                runAsNonRoot: true
          enableServiceLinks: false
          securityContext:
            fsGroupChangePolicy: OnRootMismatch
            runAsNonRoot: true
            runAsUser: 65534
            seccompProfile:
              type: RuntimeDefault
