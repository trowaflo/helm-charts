{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "persistent-volume values",
  "description": "The root stays open: consumers share one global values file across several charts. Every PV and PVC entry is closed; Kubernetes API objects passed through as-is (nodeAffinity, selector, local, iscsi...) are validated by the API server.",
  "type": "object",
  "properties": {
    "nameOverride": { "type": ["string", "null"] },
    "fullnameOverride": { "type": ["string", "null"] },
    "namespaceOverride": { "type": ["string", "null"] },
    "persistentVolumes": {
      "type": ["object", "null"],
      "additionalProperties": { "$ref": "#/definitions/persistentVolume" }
    },
    "persistentVolumeClaims": {
      "type": ["object", "null"],
      "additionalProperties": { "$ref": "#/definitions/persistentVolumeClaim" }
    }
  },
  "definitions": {
    "stringMap": {
      "type": ["object", "null"],
      "additionalProperties": { "type": ["string", "null"] }
    },
    "quantity": { "type": ["string", "integer"] },
    "accessModes": {
      "type": "array",
      "items": { "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"] }
    },
    "persistentVolume": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string" },
        "labels": { "$ref": "#/definitions/stringMap" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "capacity": { "$ref": "#/definitions/quantity" },
        "accessModes": { "$ref": "#/definitions/accessModes" },
        "storageClassName": { "type": "string" },
        "persistentVolumeReclaimPolicy": { "enum": ["Retain", "Delete", "Recycle"] },
        "volumeMode": { "enum": ["Filesystem", "Block"] },
        "mountOptions": { "type": "array", "items": { "type": "string" } },
        "nodeAffinity": { "type": "object" },
        "claimRef": { "type": "object" },
        "hostPath": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string" },
            "type": { "type": "string" }
          }
        },
        "nfs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "server": { "type": "string" },
            "path": { "type": "string" },
            "readOnly": { "type": "boolean" }
          }
        },
        "local": { "type": "object" },
        "iscsi": { "type": "object" },
        "cephfs": { "type": "object" },
        "glusterfs": { "type": "object" }
      }
    },
    "persistentVolumeClaim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string" },
        "namespace": { "type": "string" },
        "labels": { "$ref": "#/definitions/stringMap" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "accessModes": { "$ref": "#/definitions/accessModes" },
        "storageClassName": { "type": "string" },
        "volumeMode": { "enum": ["Filesystem", "Block"] },
        "volumeName": { "type": "string" },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "storage": { "$ref": "#/definitions/quantity" } }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "storage": { "$ref": "#/definitions/quantity" } }
            }
          }
        },
        "selector": { "type": "object" },
        "dataSource": { "type": "object" },
        "dataSourceRef": { "type": "object" }
      }
    }
  }
}
